cabal-version:      2.4
name:               borrowed-seconds
version:            0.1.0.0
synopsis:           One-level time-exchange puzzle prototype (Haskell GameJam practice).
license:            NONE
build-type:         Simple
extra-doc-files:    README.md

common shared
  default-language: Haskell2010
  ghc-options:      -Wall -O2

-- The pure core. No graphics dependency, so `cabal test` needs no OpenGL/GLUT
-- and the rules cannot import Gloss by accident.
library
  import:           shared
  hs-source-dirs:   src
  exposed-modules:  Game.Types
                    Game.Level
                    Game.Collision
                    Game.Logic
                    Game.Input
                    Game.Clock
                    Game.Route
                    Game.Fx
  build-depends:    base >=4.18 && <5, containers >=0.6 && <0.8

executable borrowed-seconds
  import:           shared
  hs-source-dirs:   app
  main-is:          Main.hs
  other-modules:    Dial
                    Draw
                    Figures
                    Font
                    Hud
                    Platform
                    Render
                    Scene
                    Screens
  build-depends:    base >=4.18 && <5, borrowed-seconds, gloss ==1.13.*
  ghc-options:      -threaded "-with-rtsopts=-A32m"
  -- For the window's close button: see app/Platform.hs.
  if os(darwin)
    frameworks:     GLUT
    extra-libraries: objc

test-suite spec
  import:           shared
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Main.hs
  build-depends:    base >=4.18 && <5, borrowed-seconds
